  <Item class="Workspace" referent="44">
    <Properties>
      <string name="Name">Workspace</string>
      <Ref name="CurrentCamera">45</Ref>
      <float name="FallenPartsDestroyHeight">-80</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
    </Properties>
    <Item class="Folder" referent="46">
      <Properties>
        <string name="Name">Map</string>
        <BinaryString name="AttributesSerialize">AQAAABEAAABIZWlzdEJha2VkVmVyc2lvbgUAAIA/</BinaryString>
      </Properties>
      <Item class="Folder" referent="47">
        <Properties>
          <string name="Name">Hub</string>
        </Properties>
        <Item class="Part" referent="48">
          <Properties>
            <string name="Name">HubIsland</string>
            <bool name="Anchored">true</bool>
            <token name="BottomSurface">0</token>
            <CoordinateFrame name="CFrame">
              <X>0</X>
              <Y>-4</Y>
              <Z>-40</Z>
              <R00>1</R00>
              <R01>0</R01>
              <R02>0</R02>
              <R10>0</R10>
              <R11>1</R11>
              <R12>0</R12>
              <R20>0</R20>
              <R21>0</R21>
