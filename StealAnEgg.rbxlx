        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">EggState</string>
            <string name="Source"><![CDATA[--!strict
local State = {}
function State.claim(egg, userId: number, now: number)
    if egg.State ~= "Nest" and egg.State ~= "Dropped" then return false end
    if now < egg.LockUntil or egg.Transfers >= 3 then return false end
    if egg.State == "Dropped" then egg.Transfers += 1 end
    egg.State = "Carried"; egg.Owner = userId
    return true
end
function State.drop(egg, now: number)
    if egg.State ~= "Carried" then return false end
    egg.State = "Dropped"; egg.Owner = nil; egg.LockUntil = now + 1.5
    return true
end
function State.deliver(egg, userId: number)
    if egg.State ~= "Carried" or egg.Owner ~= userId then return false end
    egg.State = "Delivered"; egg.Owner = nil
    return true
end
return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Incubation</string>
            <string name="Source"><![CDATA[--!strict
export type StoredEgg = {Uid:string, Id:string, ReadyAt:number, Mutation:boolean}
export type Pet = {Uid:string, Id:string, EggId:string, Mutation:boolean}
type IncubatorProfile = {OwnedEggs:{StoredEgg}, Pets:{Pet}, Upgrades:{Incubator:number}}
type EggCatalog = {[string]:{HatchTime:number}}
local Incubation = {}
function Incubation.start(profile: IncubatorProfile, uid: string, now: number, catalog: EggCatalog)
    for _,egg in ipairs(profile.OwnedEggs) do
        if egg.Uid==uid then
            if egg.ReadyAt~=0 or not catalog[egg.Id] then return false end
            egg.ReadyAt=now+math.max(3,math.floor(catalog[egg.Id].HatchTime*(1-profile.Upgrades.Incubator*.1)))
            return true
        end
    end
    return false
end
function Incubation.finish(profile: IncubatorProfile, now: number, maxPets: number)
    local hatched={}
    for i=#profile.OwnedEggs,1,-1 do
        local egg=profile.OwnedEggs[i]
        if egg.ReadyAt>0 and egg.ReadyAt<=now and #profile.Pets<maxPets then
            table.remove(profile.OwnedEggs,i)
            table.insert(profile.Pets,{Uid=egg.Uid,Id=egg.Id.."_pet",EggId=egg.Id,Mutation=egg.Mutation})
            table.insert(hatched,egg)
        end
    end
    return hatched
end
return Incubation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Profile</string>
            <string name="Source"><![CDATA[--!strict
local Profile = {}
local function copy(value: any): any
    if type(value) ~= "table" then return value end
    local result = {}
    for k,v in pairs(value) do result[k] = copy(v) end
    return result
end
Profile.copy = copy
local function integer(v, minimum, maximum)
    return type(v)=="number" and v==v and v>=minimum and v<=maximum and v%1==0
end
-- Dynamic input is validated field by field before becoming an in-memory profile.
function Profile.validate(data: any, catalog: any)
    if type(data)~="table" or data.Version~=1 then return false end
    if not integer(data.Coins,0,10000000) or not integer(data.Level,1,1000000)
        or not integer(data.XP,0,100000000) or not integer(data.TotalDelivered,0,100000000)
        or not integer(data.BestCombo,0,100000000) or not integer(data.Tutorial,0,3) then return false end
    if type(data.BestEscape)~="number" or data.BestEscape~=data.BestEscape or data.BestEscape<0 or data.BestEscape>10000000 then return false end
    for _, key in ipairs({"OwnedEggs", "Pets", "Upgrades", "QuestProgress", "Settings", "Achievements", "UnlockedBiomes", "Inventory"}) do
        if type(data[key]) ~= "table" then return false end
    end
    if #data.OwnedEggs>12 or #data.Pets>100 then return false end
    for key,max in pairs({Speed=4,Stamina=4,Dash=3,Incubator=4,Ward=3}) do
        if not integer(data.Upgrades[key],0,max) then return false end
    end
    local q=data.QuestProgress
    if not integer(q.Day,0,10000000) or not integer(q.Deliveries,0,100000000)
        or not integer(q.Hatches,0,100000000) or type(q.Claimed)~="boolean" then return false end
    if type(data.Settings.LowFX)~="boolean" or type(data.Settings.Muted)~="boolean" then return false end
    local ids = {}
    for _, list in ipairs({data.OwnedEggs, data.Pets}) do
        for _, item in ipairs(list) do
            if type(item)~="table" or type(item.Uid)~="string" or #item.Uid==0 or #item.Uid>64 or ids[item.Uid] then return false end
            ids[item.Uid] = true
            if type(item.Id)~="string" or type(item.Mutation)~="boolean" then return false end
        end
    end
    for _,egg in ipairs(data.OwnedEggs) do
        if not integer(egg.ReadyAt,0,100000000000) or (catalog and not catalog[egg.Id]) then return false end
    end
    for _,pet in ipairs(data.Pets) do
        if type(pet.EggId)~="string" or pet.Id~=pet.EggId.."_pet" or (catalog and not catalog[pet.EggId]) then return false end
    end
    return true
end
return Profile
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Rules</string>
            <string name="Source"><![CDATA[--!strict
-- Pure authoritative rules. No Roblox services or client-provided prices/rewards.
local Rules = {}
function Rules.cost(base: number, level: number): number
    return math.floor(base * 1.7 ^ level)
end
function Rules.day(now: number): number return math.floor(now / 86400) end
function Rules.roll(catalog, biome: string, unit: number)
    local ids = {}
    for id, egg in pairs(catalog) do if egg.Biome == biome then table.insert(ids, id) end end
    table.sort(ids)
    local sum = 0
    for _, id in ipairs(ids) do sum += catalog[id].SpawnWeight end
    local cursor = math.clamp(unit, 0, 0.9999999) * sum
    for _, id in ipairs(ids) do
        cursor -= catalog[id].SpawnWeight
        if cursor < 0 then return id end
    end
    return ids[#ids]
end
function Rules.pickup(egg, player, now: number, distance: number)
    if distance~=distance or distance<0 or distance==math.huge or now~=now then return false, "Неверная позиция" end
    if not player.Alive or player.Carrying then return false, "Руки заняты" end
    if egg.State ~= "Nest" and egg.State ~= "Dropped" then return false, "Яйцо уже забрали" end
    if distance > 11 then return false, "Подойди ближе" end
    if now < egg.LockUntil then return false, "Подожди секунду" end
    if egg.Transfers >= 3 then return false, "Скорлупе нужен отдых" end
    return true, ""
end
function Rules.canIntercept(attacker, victim, now: number, distance: number)
    return attacker.Alive and victim.Alive and not attacker.Carrying and victim.Carrying
        and not attacker.Safe and not victim.Safe and not attacker.Protected and not victim.Protected
        and now >= attacker.InterceptAt and now >= victim.ShieldUntil and distance <= 7
end
function Rules.reward(value: number, combo: number, mutation: boolean, event: boolean): number
    return math.floor(value * (1 + math.min(combo, 5) * 0.05) * (if mutation then 1.1 else 1) * (if event then 1.25 else 1))
end
function Rules.rating(seconds: number, damage: number, dodges: number): string
    local score = 100 - seconds * 0.9 - damage * 0.7 + math.min(dodges, 3) * 4
    return if score >= 85 then "S+" elseif score >= 72 then "S" elseif score >= 55 then "A" elseif score >= 35 then "B" else "C"
end
function Rules.buy(profile, id: string, config)
    local def = config[id]
    if not def then return false, "Неизвестное улучшение" end
    local level = profile.Upgrades[id] or 0
    if level >= def.Max then return false, "Максимальный уровень" end
    local cost = Rules.cost(def.BaseCost, level)
    if profile.Coins < cost then return false, "Не хватает монет" end
    profile.Coins -= cost
    profile.Upgrades[id] = level + 1
    return true, "Улучшение куплено"
end
function Rules.newProfile(now: number)
    return {Version=1, Coins=0, XP=0, Level=1, UnlockedBiomes={Meadow=true}, OwnedEggs={}, Pets={},
        Upgrades={Speed=0, Stamina=0, Dash=0, Incubator=0, Ward=0}, Inventory={}, Achievements={},
        QuestProgress={Day=Rules.day(now), Deliveries=0, Hatches=0, Claimed=false},
        Settings={LowFX=false, Muted=false}, TotalDelivered=0, BestCombo=0, BestEscape=0, Tutorial=0}
end
function Rules.daily(profile, now: number)
    if profile.QuestProgress.Day ~= Rules.day(now) then
        profile.QuestProgress = {Day=Rules.day(now), Deliveries=0, Hatches=0, Claimed=false}
    end
    return profile.QuestProgress
end
function Rules.xp(profile: {XP:number, Level:number}, amount: number)
    profile.XP += amount
    while profile.XP >= profile.Level * 100 do
        profile.XP -= profile.Level * 100
        profile.Level += 1
    end
end
return Rules
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="19">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="20">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="21">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local remotesFolder=Instance.new("Folder"); remotesFolder.Name="Remotes"; remotesFolder.Parent=ReplicatedStorage
local remotes={}
for _,name in ipairs({"Action","State","Notice","Effect"}) do
    local remote=Instance.new("RemoteEvent"); remote.Name=name; remote.Parent=remotesFolder; remotes[name]=remote
end
local data=require(script.Parent.Services.DataService).new()
local gameService=require(script.Parent.Services.GameService).new(remotes,data)
remotes.Action.OnServerEvent:Connect(function(...) gameService:action(...) end)
Players.PlayerAdded:Connect(function(player) gameService:add(player) end)
Players.PlayerRemoving:Connect(function(player) gameService:remove(player) end)
for _,player in ipairs(Players:GetPlayers()) do task.spawn(function() gameService:add(player) end) end
local errorTimes={}
local function step(name,callback)
    local ok,err=pcall(callback)
    if not ok and os.clock()>=(errorTimes[name] or 0) then
        errorTimes[name]=os.clock()+10
        warn("EggHeist "..name..": "..tostring(err))
    end
end
-- A single bounded scheduler for all gameplay actors. DataStore I/O runs independently.
task.spawn(function()
    local previous=os.clock(); local nextState=0; local nextProgress=0
    while not gameService.Closing do
        local now=os.clock(); local dt=math.min(.5,now-previous); previous=now
        for p in pairs(gameService.Sessions) do
            step("player update",function() gameService.Movement:update(p,dt); gameService.Eggs:deliver(p) end)
        end
        step("guardians",function() gameService.Guardians:update(dt) end)
        step("eggs",function() gameService.Eggs:update() end)
        step("events",function() gameService.Events:update() end)
        if now>=nextProgress then
            nextProgress=now+1
            for p in pairs(gameService.Sessions) do step("progression",function() gameService.Progression:update(p) end) end
        end
        if now>=nextState then
            nextState=now+.5
            for p in pairs(gameService.Sessions) do step("snapshot",function() gameService:snapshot(p) end) end
        end
        task.wait(.2)
    end
end)
task.spawn(function()
    while not gameService.Closing do
        task.wait(45)
        if gameService.Closing then break end
        for p in pairs(gameService.Sessions) do task.spawn(function() data:save(p,false) end) end
    end
end)
game:BindToClose(function()
    gameService.Closing=true
    local remaining=0
    for p in pairs(gameService.Sessions) do
        remaining+=1
        task.spawn(function() step("shutdown save",function() gameService:remove(p) end); remaining-=1 end)
    end
    local deadline=os.clock()+25
    while (remaining>0 or next(gameService.Joining)~=nil or next(gameService.Removing)~=nil) and os.clock()<deadline do task.wait(.1) end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="22">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Rules = require(Shared.Domain.Rules)
local Profile = require(Shared.Domain.Profile)
local Catalog = require(Shared.Config.EggConfig)
local Data = {}
Data.__index = Data
local LEASE_SECONDS = 180
local FAILURE_LIMIT = 110
function Data.new()
    local self = setmetatable({}, Data)
    self.Session = game.JobId .. HttpService:GenerateGUID(false)
    self.Entries = {}
    self.Loading = {}
    -- Studio defaults to isolated volatile sessions. Opt in using a server attribute, on a TEST place.
    self.Memory = RunService:IsStudio() and workspace:GetAttribute("EnableStudioDataStore") ~= true
    if self.Memory then
        warn("EggHeist: Studio memory mode; progress is NOT saved between play sessions")
    else
        -- Merely obtaining a store can fail for an unpublished Studio file.
        -- Local play does not need any DataStore API or publication permission.
        self.Store = DataStoreService:GetDataStore("EggHeist_Profiles_v1")
    end
    return self
end
function Data:load(player)
    if self.Entries[player] then return self.Entries[player].Profile end
    -- PlayerAdded and the initial GetPlayers sweep may observe the same player.
    if self.Loading[player] then return nil end
    self.Loading[player] = true
    local lease = self.Session .. ":" .. HttpService:GenerateGUID(false)
    if self.Memory then
        local p = Rules.newProfile(os.time())
        self.Entries[player] = {Profile=p, Busy=false, LastSave=os.time(), Lease=lease, LeaseExpires=math.huge}
        self.Loading[player] = nil
        return p
    end
    for attempt=1,3 do
        local ok, result = pcall(function()
            return self.Store:UpdateAsync("u_"..player.UserId, function(record)
                if record and record.Session ~= lease and (record.Expires or 0) > os.time() then return nil end
                local p = if record then record.Profile else Rules.newProfile(os.time())
                if not Profile.validate(p,Catalog) then error("Unsupported/corrupt profile; refusing replacement") end
                return {Profile=p, Session=lease, Expires=os.time()+LEASE_SECONDS}
            end)
        end)
        -- UpdateAsync may rerun or cancel its callback. Only its committed result
        -- establishes ownership; a callback's local side effects do not.
        if ok and result and result.Session == lease then
            local loaded = Profile.copy(result.Profile)
            self.Entries[player] = {Profile=loaded, Busy=false, LastSave=os.time(), Lease=lease, LeaseExpires=result.Expires}
            self.Loading[player] = nil
            return loaded
        end
        warn("Profile load failed", player.UserId, attempt, if ok then "session locked" else tostring(result))
        if attempt<3 then task.wait(attempt) end
    end
    self.Loading[player] = nil
    return nil
end
function Data:save(player, release: boolean?)
    local entry = self.Entries[player]
    if not entry or entry.Released or entry.Lost then return false end
    -- If a leave races a slow autosave, that writer must still release the final
    -- profile even when the caller's bounded wait runs out.
    if release then entry.ReleaseRequested=true end
    local deadline = os.clock()+12
    while entry.Busy and os.clock()<deadline do task.wait(0.1) end
    if entry.Busy or entry.Released or entry.Lost or self.Entries[player]~=entry then return false end
    entry.Busy = true
    if self.Memory then
        entry.Busy = false
        if release then entry.Released=true; self.Entries[player] = nil end
        return true
    end
    local snapshot = Profile.copy(entry.Profile)
    if not Profile.validate(snapshot,Catalog) then
        entry.Busy=false
        entry.Lost=true
        warn("Invalid in-memory profile refused",player.UserId)
        player:Kick("Обнаружена ошибка данных. Предыдущее сохранение защищено.")
        return false
    end
    local saved = false
    local savedExpires
    local lostLease = false
    local writeId = HttpService:GenerateGUID(false)
    for attempt=1,3 do
        local ok, result = pcall(function()
            return self.Store:UpdateAsync("u_"..player.UserId, function(record)
                if not record or record.Session ~= entry.Lease or (record.Expires or 0)<=os.time() then return nil end
                return {Profile=snapshot, Session=if release then nil else entry.Lease,
                    Expires=if release then 0 else os.time()+LEASE_SECONDS, WriteId=writeId}
            end)
        end)
        saved = ok and result~=nil and result.WriteId==writeId
        if saved then savedExpires=result.Expires; break end
        if ok then lostLease=true; break end
        if attempt<3 then task.wait(attempt) end
    end
    entry.Busy = false
    if saved then entry.LastSave = os.time(); entry.LeaseExpires=savedExpires end
    if release then entry.Released=true; self.Entries[player] = nil
    elseif lostLease or (not saved and os.time()-entry.LastSave > FAILURE_LIMIT) then
        entry.Lost=true
        player:Kick("Сохранение временно недоступно. Перезайди позже — старые данные защищены.")
    end
    if not release and entry.ReleaseRequested and not entry.Lost then return self:save(player,true) end
    return saved
end
function Data:isActive(player)
    local entry = self.Entries[player]
    -- A request can be stuck in flight. Stop gameplay before its last confirmed
    -- lease expires even while no autosave result has returned yet.
    return entry~=nil and not entry.Lost and not entry.Released
        and (self.Memory or os.time()<entry.LeaseExpires-15)
end
return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">EggService</string>
            <string name="Source"><![CDATA[--!strict
local HttpService=game:GetService("HttpService")
local Shared=game:GetService("ReplicatedStorage").Shared
local Rules=require(Shared.Domain.Rules)
local State=require(Shared.Domain.EggState)
local Catalog=require(Shared.Config.EggConfig)
local Config=require(Shared.Config.EconomyConfig)
local World=require(script.Parent.WorldService)
local Eggs={}; Eggs.__index=Eggs
function Eggs.new(gameService) return setmetatable({Game=gameService, Eggs={}, NestEggs={}},Eggs) end
function Eggs:spawn(nest, forced)
    if self.Game.Closing or self.NestEggs[nest.Index] then return nil end
    local id=forced or Rules.roll(Catalog,"Meadow",math.random())
    local def=Catalog[id]; local mutated=math.random()<.04
    local model=World.egg(self.Game.World.Eggs,def,nest.Part.Position+Vector3.new(0,2.2,0),mutated)
    local uid=HttpService:GenerateGUID(false)
    local egg={Uid=uid,Id=id,State="Nest",Owner=nil,LockUntil=0,Transfers=0,Model=model,Nest=nest,
        Mutation=mutated,Event=self.Game.EventActive,Original=nest.Part.Position}
    egg.Prompt=World.prompt(model.PrimaryPart,"Украсть",def.Name.." • "..def.Rarity,1,function(p) self:pickup(p,uid) end)
    World.label(model.PrimaryPart,def.Name.."\n"..def.Rarity,Color3.fromRGB(table.unpack(def.Color)))
    self.Eggs[uid]=egg; self.NestEggs[nest.Index]=uid
    return egg
end
function Eggs:replenish(egg)
    if not egg.Nest or self.NestEggs[egg.Nest.Index]~=egg.Uid then return end
    self.NestEggs[egg.Nest.Index]=nil
    if egg.Nest.Temporary then return end
    local nest=egg.Nest
    task.delay(Config.NestRespawn,function()
        if not self.Game.Closing and not self.NestEggs[nest.Index] then self:spawn(nest) end
    end)
end
function Eggs:pickup(player,uid)
    local s=self.Game.Sessions[player]; local egg=self.Eggs[uid]; local root=self.Game:root(player)
    if not s or not egg or not root or not egg.Model.PrimaryPart or not self.Game:allow(player,"pickup",.3) then return end
    if #s.Profile.OwnedEggs>=Config.MaxStoredEggs then self.Game:notify(player,"Инкубатор полон — вылупи яйца"); return end
    local ok=Rules.pickup(egg,{Alive=true,Carrying=s.Carry~=nil},os.clock(),(root.Position-egg.Model.PrimaryPart.Position).Magnitude)
    if not ok then return end
    if not self.Game:lineOfSight(player,egg.Model.PrimaryPart) then return end
    -- No yielding between validation, state claim and ownership assignment.
    if not State.claim(egg,player.UserId,os.clock()) then return end
    self:replenish(egg)
    s.Carry=uid; s.Started=os.clock(); s.Damage=0; s.Dodges=0; s.LastActive=os.clock(); s.Profile.Tutorial=math.max(s.Profile.Tutorial,1)
    egg.Prompt.Enabled=false
    egg.Model:PivotTo(root.CFrame*CFrame.new(0,.2,-2.6))
    egg.Model.PrimaryPart.Anchored=false
    local weld=Instance.new("WeldConstraint"); weld.Name="CarryWeld"; weld.Part0=root; weld.Part1=egg.Model.PrimaryPart; weld.Parent=egg.Model.PrimaryPart
    egg.Weld=weld
    self.Game.Guardians:alarm(egg.Nest.Index,player)
    self.Game:notify(player,"ЯЙЦО У ТЕБЯ! Вернись на свой зелёный круг","Pickup"); s.Dirty=true
end
function Eggs:drop(player,failed)
    local s=self.Game.Sessions[player]
    local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local egg=s and s.Carry and self.Eggs[s.Carry]
    if not egg then if s then s.Carry=nil end; return end
    if egg.Owner~=player.UserId or not State.drop(egg,os.clock()) then s.Carry=nil; return end
    s.Carry=nil; s.Sprint=false
    if failed then s.Combo=0; s.ShieldUntil=os.clock()+Config.LossProtection end
    if egg.Weld then egg.Weld:Destroy(); egg.Weld=nil end
    egg.Model.PrimaryPart.Anchored=true
    local pos=if root then root.Position+root.CFrame.LookVector*4 else egg.Original+Vector3.new(0,4,0)
    local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={egg.Model,player.Character or egg.Model}
    local floor=workspace:Raycast(pos+Vector3.new(0,8,0),Vector3.new(0,-40,0),params)
    if floor then pos=Vector3.new(pos.X,floor.Position.Y+2.2,pos.Z) else pos=egg.Original+Vector3.new(0,3,0) end
    egg.Model:PivotTo(CFrame.new(pos)); egg.Expires=os.clock()+Config.DropLifetime
    task.delay(Config.PickupProtection,function()
        if egg.State=="Dropped" and egg.Model.Parent then
            egg.Prompt.ActionText="Поднять"; egg.Prompt.Enabled=egg.Transfers<Config.MaxTransfers
        end
    end)
    self.Game:notify(player,if failed then "Яйцо потеряно. Прогресс коллекции в безопасности." else "Яйцо брошено"); s.Dirty=true
end
function Eggs:deliver(player)
    local s=self.Game.Sessions[player]; local root=self.Game:root(player)
    local egg=s and s.Carry and self.Eggs[s.Carry]
    if not egg or not root or not s.Base or (root.Position-s.Base.Pad.Position).Magnitude>9 then return end
    if #s.Profile.OwnedEggs>=Config.MaxStoredEggs then
        if self.Game:allow(player,"full-incubator",4) then self.Game:notify(player,"Инкубатор полон. Вылупи яйцо, чтобы освободить место.") end
        return
    end
    if not State.deliver(egg,player.UserId) then return end
    local def=Catalog[egg.Id]
    s.Carry=nil; s.Combo+=1
    local elapsed=math.max(0,os.clock()-(s.Started or os.clock()))
    local reward=Rules.reward(def.Value,s.Combo,egg.Mutation,egg.Event)
    self.Game:coins(player,reward); Rules.xp(s.Profile,25)
    table.insert(s.Profile.OwnedEggs,{Uid=egg.Uid,Id=egg.Id,Mutation=egg.Mutation,ReadyAt=0})
    s.Profile.TotalDelivered+=1; s.Profile.BestCombo=math.max(s.Profile.BestCombo,s.Combo)
    if s.Profile.BestEscape==0 or elapsed<s.Profile.BestEscape then s.Profile.BestEscape=math.floor(elapsed*100)/100 end
    Rules.daily(s.Profile,os.time()).Deliveries+=1
    s.Profile.Tutorial=math.max(s.Profile.Tutorial,2)
    s.Profile.Achievements.FirstDelivery=true
    self.Game:notify(player,string.format("ПОБЕГ %s • +%d монет • серия %d",Rules.rating(elapsed,s.Damage,s.Dodges),reward,s.Combo),"Delivery")
    egg.Model:Destroy(); self.Eggs[egg.Uid]=nil; s.LastActive=os.clock(); s.Dirty=true
end
function Eggs:update()
    for uid,egg in pairs(self.Eggs) do
        if egg.State=="Dropped" and os.clock()>egg.Expires then egg.Model:Destroy(); self.Eggs[uid]=nil end
    end
end
return Eggs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--!strict
local Shared=game:GetService("ReplicatedStorage").Shared
local Config=require(Shared.Config.EconomyConfig)
local World=require(script.Parent.WorldService)
local Events={}; Events.__index=Events
function Events.new(gameService)
    local self=setmetatable({Game=gameService,NextAt=os.clock()+Config.EventInterval,Ends=0,Active=false,Egg=nil},Events)
    local part=World.part(gameService.World.Map,"GoldenNest",Vector3.new(8,1,8),CFrame.new(60,1,160),Color3.fromRGB(216,175,86))
    self.Nest={Part=part,Home=Vector3.new(71,4,164),Index=4,Temporary=true}
    gameService.Guardians:add(self.Nest)
    return self
end
function Events:update()
    local now=os.clock()
    if not self.Active and now>=self.NextAt then
        self.Active=true; self.Game.EventActive=true; self.Ends=now+Config.EventDuration
        self.Egg=self.Game.Eggs:spawn(self.Nest,"sunseed")
        for p,s in pairs(self.Game.Sessions) do s.Dirty=true; self.Game:notify(p,"ЗОЛОТАЯ ЛИХОРАДКА! Особое гнездо справа в лугах.","Alarm") end
    elseif self.Active and now>=self.Ends then
        self.Active=false; self.Game.EventActive=false; self.NextAt=now+Config.EventInterval
        if self.Egg and self.Egg.State=="Nest" then self.Egg.Model:Destroy(); self.Game.Eggs.Eggs[self.Egg.Uid]=nil end
        self.Game.Eggs.NestEggs[4]=nil
        self.Egg=nil
        for _,s in pairs(self.Game.Sessions) do s.Dirty=true end
    end
end
return Events
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">GameService</string>
            <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage").Shared
local Rules=require(Shared.Domain.Rules)
local Catalog=require(Shared.Config.EggConfig)
local Config=require(Shared.Config.EconomyConfig)
local World=require(script.Parent.WorldService)
local Game={}; Game.__index=Game
local ACTION_INTERVALS={Ready=.5,Sprint=.05,Dash=.15,Drop=.3,Intercept=.3,Buy=.2,Hatch=.2,Quest=.5,Equip=.2,Setting=.2}
function Game.new(remotes,data)
    local self=setmetatable({Remotes=remotes,Data=data,Sessions={},Joining={},Removing={},Closing=false,Slots={},EventActive=false},Game)
    self.World=World.build()
    self.Guardians=require(script.Parent.GuardianService).new(self)
    self.Eggs=require(script.Parent.EggService).new(self)
    self.Progression=require(script.Parent.ProgressionService).new(self)
    self.Movement=require(script.Parent.MovementService).new(self)
    for _,nest in ipairs(self.World.Nests) do self.Guardians:add(nest); self.Eggs:spawn(nest,if nest.Index==1 then "clover" else nil) end
    self.Events=require(script.Parent.EventService).new(self)
    World.prompt(self.World.Secret,"Исследовать","Тропа тихих шагов",.6,function(player)
        local s=self.Sessions[player]; local root=self:root(player)
        if s and root and (root.Position-self.World.Secret.Position).Magnitude<12 and not s.Profile.Achievements.SecretRoute then
            s.Profile.Achievements.SecretRoute=true; self:coins(player,40); Rules.xp(s.Profile,30); s.Dirty=true
            self:notify(player,"СЕКРЕТ НАЙДЕН! +40 монет")
        end
    end)
    return self
end
function Game:root(player)
    if self.Sessions[player] and not self.Data:isActive(player) then return nil end
    local c=player.Character; local h=c and c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health<=0 then return nil end
    return c:FindFirstChild("HumanoidRootPart")
end
function Game:isSafe(pos) return pos.Z<94 end
function Game:allow(player,key,interval)
    local s=self.Sessions[player]; if not s then return false end
    if self.Closing or not self.Data:isActive(player) then return false end
    local now=os.clock()
    if now<s.InvalidAt+1 then return false end
    if now<(s.Limits[key] or 0) then return false end
    s.Limits[key]=now+interval
    return true
end
function Game:lineOfSight(player,part)
    local root=self:root(player); if not root then return false end
    local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={player.Character}
    local ray=workspace:Raycast(root.Position,part.Position-root.Position,params)
    -- A shared Folder contains other walls and buildings; those cannot count as
    -- a clear hit on the target. Only the target's own Model may be accepted.
    return ray==nil or ray.Instance==part or (part.Parent:IsA("Model") and ray.Instance:IsDescendantOf(part.Parent))
end
function Game:notify(player,text,sound)
    if player.Parent==Players then self.Remotes.Notice:FireClient(player,text,sound) end
end
function Game:coins(player,amount)
    local s=self.Sessions[player]; if not s then return end
    s.Profile.Coins=math.min(Config.MaxCoins,s.Profile.Coins+math.max(0,math.floor(amount))); s.Dirty=true
end
function Game:hit(player,damage)
    local s=self.Sessions[player]; local root=self:root(player)
    if not s or not root or self:isSafe(root.Position) then return end
    local hum=player.Character:FindFirstChildOfClass("Humanoid")
    s.Damage+=damage; hum:TakeDamage(damage)
    self.Eggs:drop(player,true)
end
function Game:intercept(player)
    local s=self.Sessions[player]; local root=self:root(player)
    if not s or not root or not self:allow(player,"intercept",1) then return end
    local now=os.clock()
    for victim,other in pairs(self.Sessions) do
        local r=self:root(victim)
        if r and victim~=player and Rules.canIntercept(
            {Alive=true,Carrying=s.Carry~=nil,Safe=self:isSafe(root.Position),Protected=now<s.Joined+Config.NewPlayerProtection,InterceptAt=s.InterceptAt},
            {Alive=true,Carrying=other.Carry~=nil,Safe=self:isSafe(r.Position),Protected=now<other.Joined+Config.NewPlayerProtection,ShieldUntil=other.ShieldUntil},now,(root.Position-r.Position).Magnitude)
            and self:lineOfSight(player,r) then
            local uid=other.Carry; local egg=self.Eggs.Eggs[uid]
            if egg and egg.Transfers<Config.MaxTransfers then
                self.Eggs:drop(victim,true)
                s.InterceptAt=now+12
                self:notify(player,"Перехват! Яйцо можно поднять через секунду.")
                return
            end
        end
    end
    self:notify(player,"Перехват: нужен незащищённый носитель рядом вне хаба")
end
function Game:character(player,character)
    local s=self.Sessions[player]; if not s then return end
    local hum=character:WaitForChild("Humanoid",10); local root=character:WaitForChild("HumanoidRootPart",10)
    if not hum or not root or self.Sessions[player]~=s or player.Character~=character then return end
    self.Eggs:drop(player,true)
    s.Character=character; s.LastPosition=root.Position; s.AirSince=nil; s.GroundedPosition=root.Position
    s.SpawnGrace=os.clock()+3; s.MoveBudget=10; s.Stamina=Config.BaseStamina+s.Profile.Upgrades.Stamina*12; s.Sprint=false
    s.MovementStrikes=0; s.InvalidAt=-100
    if s.DeathConnection then s.DeathConnection:Disconnect() end
    s.DeathConnection=hum.Died:Connect(function()
        if self.Sessions[player]==s and s.Character==character then self.Eggs:drop(player,true); s.Sprint=false end
    end)
end
function Game:add(player)
    if self.Closing or self.Sessions[player] or self.Joining[player] or self.Removing[player] then return end
    self.Joining[player]=true
    local profile=self.Data:load(player)
    self.Joining[player]=nil
    if not profile then player:Kick("Данные недоступны или открыты на другом сервере. Повтори вход позже."); return end
    if player.Parent~=Players or self.Closing then self.Data:save(player,true); return end
    local slot
    for i=1,8 do if not self.Slots[i] then slot=i; break end end
    if not slot then self.Data:save(player,true); player:Kick("Восемь убежищ заняты. Выбери другой сервер."); return end
    self.Slots[slot]=player
    local s={Profile=profile,Joined=os.clock(),ShieldUntil=0,InterceptAt=0,Carry=nil,Combo=0,Damage=0,Dodges=0,
        Stamina=100,Sprint=false,DashAt=0,MoveBudget=7,SpawnGrace=os.clock()+3,LastPosition=nil,
        Limits={},InvalidAt=-100,LastActive=os.clock(),PassiveAt=os.clock()+Config.PassiveInterval,Dirty=true,ClientReady=false,Base=nil}
    self.Sessions[player]=s
    s.Base=World.base(self.World,slot,player)
    World.prompt(s.Base.Incubator,"Инкубировать","Убежище "..player.DisplayName,.5,function(p) if p==player then self.Progression:firstEgg(p) end end)
    World.prompt(s.Base.Ward,"Включить щит","Колокольчик",.5,function(p)
        local r=self:root(p)
        if p==player and r and (r.Position-s.Base.Ward.Position).Magnitude<12 and self:allow(p,"ward",30) then
            s.ShieldUntil=os.clock()+5+profile.Upgrades.Ward*2
            self:notify(p,"Щит активен ненадолго — можно выйти из хаба"); s.Dirty=true
        end
    end)
    self.Progression:display(player)
    local stats=Instance.new("Folder"); stats.Name="leaderstats"; stats.Parent=player
    for _,name in ipairs({"Coins","Eggs","Level"}) do local v=Instance.new("IntValue"); v.Name=name; v.Parent=stats end
    s.CharacterConnection=player.CharacterAdded:Connect(function(c) self:character(player,c) end)
    s.CharacterRemovingConnection=player.CharacterRemoving:Connect(function(c)
        if self.Sessions[player]==s and (s.Character==c or player.Character==c) then
            self.Eggs:drop(player,true); s.Sprint=false; s.Character=nil
        end
    end)
    if player.Character then task.spawn(function() self:character(player,player.Character) end) end
end
function Game:remove(player)
    if self.Removing[player] then return end
    self.Removing[player]=true
    local s=self.Sessions[player]
    if s then
        self.Eggs:drop(player,true)
        if s.CharacterConnection then s.CharacterConnection:Disconnect() end
        if s.CharacterRemovingConnection then s.CharacterRemovingConnection:Disconnect() end
        if s.DeathConnection then s.DeathConnection:Disconnect() end
        self.Slots[s.Base.Index]=nil; s.Base.Model:Destroy(); self.Sessions[player]=nil
    end
    self.Data:save(player,true)
    self.Removing[player]=nil
end
function Game:action(player,action,arg)
    if type(action)~="string" or not ACTION_INTERVALS[action] then return end
    local s=self.Sessions[player]; if not s or self.Closing then return end
    -- Releasing sprint must not be discarded by an unrelated button's throttle.
    if action=="Sprint" and arg==false then s.Sprint=false; return end
    if not self:allow(player,"action:"..action,ACTION_INTERVALS[action]) then return end
    if action=="Ready" then s.ClientReady=true; s.Dirty=true
    elseif action=="Sprint" and type(arg)=="boolean" then s.Sprint=arg
    elseif action=="Dash" then self.Movement:dash(player)
    elseif action=="Drop" then self.Eggs:drop(player,false)
    elseif action=="Intercept" then self:intercept(player)
    elseif action=="Buy" and type(arg)=="string" and #arg<40 then self.Progression:buy(player,arg)
    elseif action=="Hatch" and type(arg)=="string" and #arg<50 then self.Progression:hatch(player,arg)
    elseif action=="Quest" then self.Progression:claim(player)
    elseif action=="Equip" and type(arg)=="string" and #arg<50 then
        for i,pet in ipairs(s.Profile.Pets) do
            if pet.Uid==arg then table.remove(s.Profile.Pets,i); table.insert(s.Profile.Pets,1,pet); self.Progression:display(player); s.Dirty=true; break end
        end
    elseif action=="Setting" and (arg=="LowFX" or arg=="Muted") then s.Profile.Settings[arg]=not s.Profile.Settings[arg]; s.Dirty=true end
end
function Game:snapshot(player)
    local s=self.Sessions[player]; if not s then return end
    local root=self:root(player); local egg=s.Carry and self.Eggs.Eggs[s.Carry]
    self.Remotes.State:FireClient(player,{
        Profile=if s.Dirty or not s.ClientReady then s.Profile else nil, Stamina=s.Stamina, MaxStamina=Config.BaseStamina+s.Profile.Upgrades.Stamina*12,
        Carry=if egg then {Id=egg.Id,Mutation=egg.Mutation} else false,
        Safe=if root then self:isSafe(root.Position) else true, Combo=s.Combo,
        Protection=math.max(0,math.ceil(s.Joined+Config.NewPlayerProtection-os.clock())),
        Shield=math.max(0,math.ceil(s.ShieldUntil-os.clock())),Dash=math.max(0,s.DashAt-os.clock()),
        Intercept=math.max(0,s.InterceptAt-os.clock()),Sprint=s.Sprint,ServerTime=workspace:GetServerTimeNow(),
        InIncubatorRange=root~=nil and (root.Position-s.Base.Incubator.Position).Magnitude<=13,
        Event=self.EventActive, EventSeconds=math.max(0,math.ceil((if self.EventActive then self.Events.Ends else self.Events.NextAt)-os.clock())),
        Base={X=s.Base.Center.X,Z=s.Base.Center.Z,
            PadX=s.Base.Pad.Position.X,PadY=s.Base.Pad.Position.Y,PadZ=s.Base.Pad.Position.Z,
            IncubatorX=s.Base.Incubator.Position.X,IncubatorY=s.Base.Incubator.Position.Y,IncubatorZ=s.Base.Incubator.Position.Z}, Memory=self.Data.Memory,
    })
    s.Dirty=false
    local stats=player:FindFirstChild("leaderstats")
    if stats then stats.Coins.Value=s.Profile.Coins; stats.Eggs.Value=s.Profile.TotalDelivered; stats.Level.Value=s.Profile.Level end
end
return Game
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">GuardianService</string>
            <string name="Source"><![CDATA[--!strict
local Pathfinding = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config.GuardianConfig)
local World = require(script.Parent.WorldService)
local Guardian = {}; Guardian.__index=Guardian
local stateLabels={IDLE="Отдыхает",PATROL="Патрулирует",SUSPICIOUS="Что за шум?",ALERT="ТРЕВОГА!",CHASE="ПОГОНЯ!",ATTACK="БЕРЕГИСЬ!",RETURN="Возвращается",RECOVER="Переводит дух"}
function Guardian.new(gameService)
    return setmetatable({Game=gameService, Actors={}},Guardian)
end
function Guardian:add(nest)
    local model=Instance.new("Model"); model.Name="Guardian_Hen"; model.Parent=self.Game.World.Map
    local body=World.part(model,"Body",Vector3.new(6,6,7),CFrame.new(nest.Home),Color3.fromRGB(255,231,172),nil,Enum.PartType.Ball)
    model.PrimaryPart=body
    World.part(model,"Head",Vector3.new(3.7,3.7,3.7),CFrame.new(nest.Home+Vector3.new(0,3,-2)),Color3.fromRGB(255,245,214),nil,Enum.PartType.Ball)
    World.part(model,"Comb",Vector3.new(1,2.2,3),CFrame.new(nest.Home+Vector3.new(0,5,-2)),Color3.fromRGB(231,100,98),nil,Enum.PartType.Ball)
    World.part(model,"Beak",Vector3.new(1.5,1.3,2),CFrame.new(nest.Home+Vector3.new(0,2.9,-4)),Color3.fromRGB(255,174,64))
    for _, x in ipairs({-1,1}) do
        World.part(model,"Eye",Vector3.new(.45,.6,.4),CFrame.new(nest.Home+Vector3.new(x,3.3,-3.5)),Color3.fromRGB(45,49,56),nil,Enum.PartType.Ball)
        World.part(model,"Wing",Vector3.new(1.5,4,4),CFrame.new(nest.Home+Vector3.new(x*3,0,0)),Color3.fromRGB(239,194,131),nil,Enum.PartType.Ball)
        World.part(model,"Foot",Vector3.new(1.6,.8,3),CFrame.new(nest.Home+Vector3.new(x*1.6,-2.6,-1)),Color3.fromRGB(255,174,64))
    end
    for _,part in ipairs(model:GetChildren()) do if part:IsA("BasePart") then part.CanCollide=false; part.CanTouch=false; part.CanQuery=false end end
    local text=World.label(body,"НАСЕДКА • Отдыхает")
    self.Actors[nest.Index]={Model=model, Home=nest.Home, Nest=nest, State="IDLE", Until=0,
        Target=nil, NextPath=0, Waypoints=nil, PathIndex=1, Computing=false, Label=text, Patrol=1}
end
function Guardian:set(actor,state,duration)
    actor.State=state; actor.Until=os.clock()+(duration or 0); actor.Label.Text="НАСЕДКА • "..(stateLabels[state] or state)
    actor.Model:SetAttribute("State",state)
end
function Guardian:alarm(index,player)
    local a=self.Actors[index]; if not a then return end
    a.Target=player; a.Waypoints=nil; a.PathEpoch=(a.PathEpoch or 0)+1; a.NeedsPathUntil=0
    self:set(a,"ALERT",1.2)
    self.Game:notify(player,"ХРАНИТЕЛЬ ПРОСНУЛСЯ! На золотую дорожку!","Alarm")
end
function Guardian:visible(actor,root)
    local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={actor.Model,self.Game.World.Eggs}
    local origin=actor.Model:GetPivot().Position+Vector3.new(0,2,0)
    local ray=workspace:Raycast(origin,root.Position-origin,params)
    return ray==nil or ray.Instance:IsDescendantOf(root.Parent)
end
function Guardian:collisionParams(actor)
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.RespectCanCollide=true
    local excluded={actor.Model,self.Game.World.Eggs}
    for _,player in ipairs(Players:GetPlayers()) do
        if player.Character then table.insert(excluded,player.Character) end
    end
    params.FilterDescendantsInstances=excluded
    return params
end
function Guardian:walk(a,destination,dt,speed)
    local pos=a.Model:GetPivot().Position
    local delta=Vector3.new(destination.X-pos.X,0,destination.Z-pos.Z)
    if delta.Magnitude<.5 then return true,false end
    local move=delta.Unit*math.min(delta.Magnitude,math.max(0,dt)*speed)
    local params=self:collisionParams(a)
    -- The NPC's visible body must not tunnel through low walls even when eye-level LOS is clear.
    local obstruction=workspace:Blockcast(CFrame.new(pos),Vector3.new(4.5,4.5,4.5),move,params)
    if obstruction then return false,true end
    local nextPos=pos+move
    local ground=workspace:Raycast(nextPos+Vector3.new(0,7,0),Vector3.new(0,-18,0),params)
    if not ground then return false,true end
    a.Model:PivotTo(CFrame.lookAt(nextPos,nextPos+delta.Unit))
    return false,false
end
function Guardian:path(a,destination)
    if a.Computing or os.clock()<a.NextPath then return end
    a.NextPath=os.clock()+Config.PathInterval; a.Computing=true
    local epoch=a.PathEpoch or 0
    task.spawn(function()
        local path=Pathfinding:CreatePath({AgentRadius=3,AgentHeight=7,AgentCanJump=false,WaypointSpacing=5})
        local ok=pcall(function() path:ComputeAsync(a.Model:GetPivot().Position,destination) end)
        -- ComputeAsync yields. A new theft or return invalidates the previous destination.
        if epoch==(a.PathEpoch or 0) then
            if ok and path.Status==Enum.PathStatus.Success then
                a.Waypoints=path:GetWaypoints(); a.PathIndex=2
            else a.Waypoints=nil end
        end
        a.Computing=false
    end)
end
function Guardian:update(dt)
    local now=os.clock()
    for _,a in pairs(self.Actors) do
        local target=a.Target; local s=target and self.Game.Sessions[target]
        local root=target and self.Game:root(target)
        local pos=a.Model:GetPivot().Position
        local chasing=a.State=="CHASE" or a.State=="ATTACK" or a.State=="ALERT"
        if chasing and (not s or not root or not s.Carry or self.Game:isSafe(root.Position) or (root.Position-a.Home).Magnitude>Config.ChaseRadius) then
            a.Target=nil; self:set(a,"RETURN"); a.Waypoints=nil; a.PathEpoch=(a.PathEpoch or 0)+1; a.NextPath=0
        end
        if a.State=="ALERT" and now>=a.Until then self:set(a,"CHASE") end
        if a.State=="CHASE" and root then
            local dist=(root.Position-pos).Magnitude
            local visible=self:visible(a,root)
            if dist<=Config.AttackDistance and visible then
                a.AttackPoint=root.Position
                a.Warning=World.part(self.Game.World.Map,"AttackWarning",Vector3.new(15,.15,15),CFrame.new(root.Position.X,1,root.Position.Z),Color3.fromRGB(255,107,92),Enum.Material.Neon,Enum.PartType.Ball)
                a.Warning.CanCollide=false; a.Warning.Transparency=.35
                self:set(a,"ATTACK",Config.Windup)
            else
                if visible and now>=(a.NeedsPathUntil or 0) then
                    a.Waypoints=nil
                    local _,blocked=self:walk(a,root.Position,dt,Config.Speed)
                    if blocked then a.NeedsPathUntil=now+2.5; self:path(a,root.Position) end
                else
                    self:path(a,root.Position)
                    local waypoint=a.Waypoints and a.Waypoints[a.PathIndex]
                    if waypoint and self:walk(a,waypoint.Position,dt,Config.Speed) then a.PathIndex+=1 end
                end
            end
        elseif a.State=="ATTACK" and now>=a.Until then
            if a.Warning then a.Warning:Destroy(); a.Warning=nil end
            local aim=a.AttackPoint
            local from=a.Model:GetPivot().Position
            local delta=Vector3.new(aim.X-from.X,0,aim.Z-from.Z)
            local attackBlocked=false
            if delta.Magnitude>.1 then
                local _,blocked=self:walk(a,aim,1,math.min(7,delta.Magnitude))
                attackBlocked=blocked
            end
            local currentRoot=target and self.Game:root(target)
            if not attackBlocked and currentRoot and (currentRoot.Position-a.AttackPoint).Magnitude<8 and not self.Game:isSafe(currentRoot.Position) and self:visible(a,currentRoot) then
                self.Game:hit(target,Config.Damage)
            elseif s then s.Dodges+=1 end
            self:set(a,"RECOVER",Config.Recovery)
        elseif a.State=="RECOVER" and now>=a.Until then
            self:set(a,if a.Target then "CHASE" else "RETURN")
        elseif a.State=="RETURN" then
            if a.Warning then a.Warning:Destroy(); a.Warning=nil end
            self:path(a,a.Home)
            local waypoint=a.Waypoints and a.Waypoints[a.PathIndex]
            if waypoint then
                if self:walk(a,waypoint.Position,dt,Config.Speed) then a.PathIndex+=1 end
            elseif (pos-a.Home).Magnitude<5 then self:set(a,"IDLE",2)
            end
        elseif a.State=="IDLE" and now>=a.Until then self:set(a,"PATROL",4)
        elseif a.State=="PATROL" then
            local destination=a.Home+Vector3.new(math.sin(a.Patrol)*8,0,math.cos(a.Patrol)*8)
            local arrived,blocked=self:walk(a,destination,dt,5)
            if arrived or blocked then a.Patrol+=1; self:set(a,"IDLE",2) end
            for _,p in ipairs(Players:GetPlayers()) do
                local r=self.Game:root(p)
                if r and (r.Position-pos).Magnitude<Config.SuspicionRadius and self:visible(a,r) then self:set(a,"SUSPICIOUS",1.5); break end
            end
        elseif a.State=="SUSPICIOUS" and now>=a.Until then self:set(a,"PATROL",4) end
    end
end
return Guardian
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">MovementService</string>
            <string name="Source"><![CDATA[--!strict
local Shared=game:GetService("ReplicatedStorage").Shared
local Config=require(Shared.Config.EconomyConfig)
local Catalog=require(Shared.Config.EggConfig)
local Movement={}; Movement.__index=Movement
function Movement.new(gameService) return setmetatable({Game=gameService},Movement) end
function Movement:speed(s)
    local speed=Config.BaseSpeed+s.Profile.Upgrades.Speed*.65
    if s.Carry then
        local egg=self.Game.Eggs.Eggs[s.Carry]
        if egg then speed-=Catalog[egg.Id].Weight*Config.CarrySlowPerWeight end
    end
    if s.Sprint and s.Stamina>0 then speed+=Config.SprintBonus end
    return math.max(10,speed)
end
function Movement:dash(player)
    local s=self.Game.Sessions[player]; local root=self.Game:root(player)
    if not s or not root or os.clock()<s.DashAt or s.Stamina<Config.DashCost then return end
    local hum=player.Character:FindFirstChildOfClass("Humanoid")
    local dir=hum.MoveDirection
    if dir.Magnitude<.1 then dir=root.CFrame.LookVector end
    dir=Vector3.new(dir.X,0,dir.Z)
    if dir.Magnitude<.1 then return end
    dir=dir.Unit
    local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={player.Character,self.Game.World.Eggs}
    local distance=Config.DashDistance
    for _,offset in ipairs({Vector3.new(0,0,0),Vector3.new(0,2,0),Vector3.new(0,-1.5,0)}) do
        local hit=workspace:Raycast(root.Position+offset,dir*distance,params)
        if hit then distance=math.max(0,hit.Distance-2.5) end
    end
    local destination=root.Position+dir*distance
    -- A dash cannot cross unsupported gaps or turn into a flight mechanic.
    local floor=workspace:Raycast(destination,Vector3.new(0,-9,0),params)
    if not floor or distance<1 then return end
    s.Stamina-=Config.DashCost; s.DashAt=os.clock()+Config.DashCooldown-s.Profile.Upgrades.Dash*.25
    root.CFrame=root.CFrame+dir*distance
    s.LastPosition=root.Position; s.MoveBudget=10; s.LastActive=os.clock(); s.MovementAt=os.clock()
    s.GroundedPosition=root.Position; s.AirSince=nil
    self.Game.Remotes.Effect:FireClient(player,"Dash")
end
function Movement:update(player,dt)
    local s=self.Game.Sessions[player]; local root=self.Game:root(player)
    if not s or not root then return end
    local hum=player.Character:FindFirstChildOfClass("Humanoid")
    local maxStamina=Config.BaseStamina+s.Profile.Upgrades.Stamina*12
    local moving=hum.MoveDirection.Magnitude>.1
    if s.Sprint and moving then s.Stamina=math.max(0,s.Stamina-Config.StaminaDrain*dt)
    else s.Stamina=math.min(maxStamina,s.Stamina+(Config.StaminaRegen+(if #s.Profile.Pets>0 then 1 else 0))*dt) end
    if s.Stamina<=0 then s.Sprint=false end
    local speed=self:speed(s); hum.WalkSpeed=speed
    local now=os.clock(); local pos=root.Position
    -- Replication arrives in bursts. Keep a bounded travel allowance and refill
    -- it using actual elapsed server time, including an occasional scheduler stall.
    local elapsed=math.clamp(now-(s.MovementAt or (now-dt)),0,2)
    s.MovementAt=now
    if s.LastPosition then
        local delta=Vector3.new(pos.X-s.LastPosition.X,0,pos.Z-s.LastPosition.Z).Magnitude
        s.MoveBudget=math.min(math.max(12,(speed+3)*1.5),s.MoveBudget+(speed+3)*elapsed)
        if delta>s.MoveBudget and os.clock()>s.SpawnGrace then
            root.CFrame=CFrame.new(s.LastPosition)*root.CFrame.Rotation
            root.AssemblyLinearVelocity=Vector3.zero
            pos=s.LastPosition; s.InvalidAt=now
        else
            s.MoveBudget=math.max(0,s.MoveBudget-delta)
            if delta>.3 then s.LastActive=os.clock() end
        end
    end
    -- Record only validated ground positions; a teleport must never become a
    -- future anti-flight recovery point.
    local groundParams=RaycastParams.new(); groundParams.FilterType=Enum.RaycastFilterType.Exclude
    groundParams.FilterDescendantsInstances={player.Character,self.Game.World.Eggs}
    local ground=workspace:Raycast(pos,Vector3.new(0,-6,0),groundParams)
    if ground then s.AirSince=nil; s.GroundedPosition=pos
    elseif not s.AirSince then s.AirSince=now
    elseif now-s.AirSince>3 and now>s.SpawnGrace then
        self.Game.Eggs:drop(player,true)
        root.CFrame=CFrame.new(s.GroundedPosition or Vector3.new(0,5,0))
        root.AssemblyLinearVelocity=Vector3.zero
        pos=root.Position; s.AirSince=nil; s.MoveBudget=10; s.SpawnGrace=now+1
    end
    s.LastPosition=pos
    if pos.Y>65 or pos.Y< -30 then
        self.Game.Eggs:drop(player,true); root.CFrame=CFrame.new(0,5,0)
        root.AssemblyLinearVelocity=Vector3.zero
        s.LastPosition=root.Position; s.GroundedPosition=root.Position; s.AirSince=nil; s.MoveBudget=10; s.SpawnGrace=now+2
    end
end
return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--!strict
local Shared=game:GetService("ReplicatedStorage").Shared
local Rules=require(Shared.Domain.Rules)
local Incubation=require(Shared.Domain.Incubation)
local Catalog=require(Shared.Config.EggConfig)
local Upgrades=require(Shared.Config.UpgradeConfig)
local Config=require(Shared.Config.EconomyConfig)
local World=require(script.Parent.WorldService)
local Progression={}; Progression.__index=Progression
function Progression.new(gameService) return setmetatable({Game=gameService},Progression) end
function Progression:hatch(player,uid)
    local s=self.Game.Sessions[player]; local root=self.Game:root(player)
    if not s or not root or not s.Base or (root.Position-s.Base.Incubator.Position).Magnitude>13 then
        self.Game:notify(player,"Подойди к своему инкубатору"); return
    end
    if not self.Game:lineOfSight(player,s.Base.Incubator) then
        self.Game:notify(player,"Подойди к инкубатору со стороны входа"); return
    end
    if #s.Profile.Pets>=Config.MaxPets then
        self.Game:notify(player,"Коллекция питомцев заполнена. Яйцо сохранено."); return
    end
    if Incubation.start(s.Profile,uid,os.time(),Catalog) then
        self.Game:notify(player,"Инкубация началась! Можно искать следующее яйцо.")
        s.Dirty=true
        s.LastActive=os.clock()
    else
        for _,egg in ipairs(s.Profile.OwnedEggs) do
            if egg.Uid==uid and egg.ReadyAt>0 then
                self.Game:notify(player,"Яйцо уже в инкубаторе — осталось "..math.max(0,egg.ReadyAt-os.time()).." сек."); return
            end
        end
    end
end
function Progression:firstEgg(player)
    local s=self.Game.Sessions[player]; if not s then return end
    for _,egg in ipairs(s.Profile.OwnedEggs) do
        if egg.ReadyAt==0 then self:hatch(player,egg.Uid); return end
    end
    self.Game:notify(player,if #s.Profile.OwnedEggs>0 then "Все яйца уже в инкубаторе. Можно искать следующее!" else "Принеси яйцо на свой круг доставки")
end
function Progression:display(player)
    local s=self.Game.Sessions[player]; if not s or not s.Base then return end
    if s.PetModel then s.PetModel:Destroy(); s.PetModel=nil end
    local pet=s.Profile.Pets[1]
    if not pet then return end
    local def=Catalog[pet.EggId]
    local model=Instance.new("Model"); model.Name="Pet_"..pet.Id; model.Parent=s.Base.Model
    local pos=s.Base.Display.Position+Vector3.new(0,2,0)
    local body=World.part(model,"Pet",Vector3.new(3,2.7,3),CFrame.new(pos),Color3.fromRGB(table.unpack(def.Color)),nil,Enum.PartType.Ball)
    for _,x in ipairs({-1,1}) do
        World.part(model,"Ear",Vector3.new(.9,1.9,.8),CFrame.new(pos+Vector3.new(x*.85,1.5,0))*CFrame.Angles(0,0,x*-.2),body.Color,nil,Enum.PartType.Ball)
        World.part(model,"Eye",Vector3.new(.35,.45,.2),CFrame.new(pos+Vector3.new(x*.65,.2,-1.4)),Color3.fromRGB(45,53,66),nil,Enum.PartType.Ball)
    end
    World.label(body,def.PetName.."\nАктивный питомец: +1 восстановление")
    s.PetModel=model
end
function Progression:buy(player,id)
    local s=self.Game.Sessions[player]; if not s then return end
    local ok,message=Rules.buy(s.Profile,id,Upgrades)
    if ok then
        s.Dirty=true
        s.LastActive=os.clock()
        if s.Base then
            s.Base.Ward.Size=Vector3.new(2,3+s.Profile.Upgrades.Ward*.7,2)
            s.Base.Incubator.Color=Color3.fromRGB(255,205,124):Lerp(Color3.fromRGB(255,246,207),s.Profile.Upgrades.Incubator/4)
        end
    end
    self.Game:notify(player,message)
end
function Progression:claim(player)
    local s=self.Game.Sessions[player]; if not s then return end
    local previousDay=s.Profile.QuestProgress.Day
    local q=Rules.daily(s.Profile,os.time())
    if previousDay~=q.Day then s.Dirty=true end
    if q.Claimed or q.Deliveries<Config.DailyDeliveryGoal or q.Hatches<Config.DailyHatchGoal then
        self.Game:notify(player,"Выполни обе ежедневные цели"); return
    end
    q.Claimed=true; self.Game:coins(player,Config.DailyReward); Rules.xp(s.Profile,50)
    self.Game:notify(player,"Ежедневная награда: +"..Config.DailyReward.." монет"); s.LastActive=os.clock(); s.Dirty=true
end
function Progression:update(player)
    local s=self.Game.Sessions[player]; if not s or not self.Game.Data:isActive(player) then return end
    local oldDay=s.Profile.QuestProgress.Day; Rules.daily(s.Profile,os.time())
    if oldDay~=s.Profile.QuestProgress.Day then s.Dirty=true end
    for _,egg in ipairs(Incubation.finish(s.Profile,os.time(),Config.MaxPets)) do
        s.Profile.QuestProgress.Hatches+=1; s.Profile.Tutorial=3; Rules.xp(s.Profile,20)
        local first=not s.Profile.Achievements[egg.Id]
        if first then s.Profile.Achievements[egg.Id]=true; self.Game:coins(player,15) end
        self.Game:notify(player,"ВЫЛУПИЛСЯ: "..Catalog[egg.Id].PetName,"Hatch")
        self.Game.Remotes.Effect:FireClient(player,"Hatch",egg.Id)
        self:display(player); s.Dirty=true
    end
    if os.clock()>=s.PassiveAt then
        s.PassiveAt=os.clock()+Config.PassiveInterval
        if #s.Profile.Pets>0 and os.clock()-s.LastActive<90 then
            self.Game:coins(player,math.min(Config.PassiveCap,#s.Profile.Pets*2)); s.Dirty=true
        end
    end
end
return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict
-- Authored, asset-free geometry. Ornament stays static and nonblocking.
local Lighting = game:GetService("Lighting")
local World = {}
local C = {
    Grass=Color3.fromRGB(113,177,108), GrassLight=Color3.fromRGB(145,194,115),
    Pine=Color3.fromRGB(45,109,89), Leaf=Color3.fromRGB(79,150,99),
    Teal=Color3.fromRGB(48,106,111), Ink=Color3.fromRGB(35,63,73),
    Cream=Color3.fromRGB(244,231,198), Gold=Color3.fromRGB(241,190,88),
    Wood=Color3.fromRGB(140,104,76), Earth=Color3.fromRGB(121,98,80),
    Stone=Color3.fromRGB(133,159,151), Mint=Color3.fromRGB(132,225,189),
    Water=Color3.fromRGB(100,193,202), White=Color3.fromRGB(249,247,228),
}
local nestPositions={Vector3.new(0,1,132),Vector3.new(-43,1,200),Vector3.new(51,1,226)}
function World.part(parent, name, size, cf, color, material, shape)
    local p=Instance.new("Part")
    p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color
    p.Anchored=true; p.Material=material or Enum.Material.SmoothPlastic
    p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    if shape then p.Shape=shape end
    p.Parent=parent
    return p
end
local function decor(parent,name,size,cf,color,material,shape)
    local p=World.part(parent,name,size,cf,color,material,shape)
    p.CanCollide=false; p.CanTouch=false; p.CanQuery=false
    return p
end
local function disc(parent,name,pos,radius,height,color,material,blocking)
    local create=if blocking then World.part else decor
    return create(parent,name,Vector3.new(height,radius*2,radius*2),
        CFrame.new(pos)*CFrame.Angles(0,0,math.pi/2),color,material,Enum.PartType.Cylinder)
end
local function ring(parent,name,pos,radius,width,color,segments)
    local count=segments or 12
    for i=1,count do
        local a=(i-.5)*math.pi*2/count
        decor(parent,name,Vector3.new(width,.18,2*radius*math.tan(math.pi/count)+.08),
            CFrame.new(pos+Vector3.new(math.cos(a)*radius,0,math.sin(a)*radius))*CFrame.Angles(0,-a,0),color)
    end
end
function World.label(part, text, color)
    local gui=Instance.new("BillboardGui"); gui.Name="Label"; gui.Size=UDim2.fromOffset(246,68)
    gui.StudsOffset=Vector3.new(0,3,0); gui.MaxDistance=80; gui.AlwaysOnTop=false; gui.Parent=part
    local l=Instance.new("TextLabel"); l.Size=UDim2.fromScale(1,1); l.BackgroundTransparency=1
    l.Text=text; l.TextColor3=color or C.Cream; l.TextStrokeColor3=C.Ink; l.TextStrokeTransparency=.18
    l.Font=Enum.Font.GothamBold; l.TextScaled=true; l.Parent=gui
    local limit=Instance.new("UITextSizeConstraint"); limit.MaxTextSize=21; limit.MinTextSize=11; limit.Parent=l
    return l
end
function World.prompt(part, action, object, hold, callback)
    local p=Instance.new("ProximityPrompt"); p.ActionText=action; p.ObjectText=object
    p.HoldDuration=hold; p.MaxActivationDistance=10; p.RequiresLineOfSight=true; p.Parent=part
    local began=setmetatable({},{__mode="k"})
    local function validRoot(player)
        local character=player.Character
        local root=character and character:FindFirstChild("HumanoidRootPart")
        local humanoid=character and character:FindFirstChildOfClass("Humanoid")
        if not p.Enabled or not part:IsDescendantOf(workspace) or not root or not root:IsA("BasePart")
            or not humanoid or humanoid.Health<=0 or (root.Position-part.Position).Magnitude>12 then return nil end
        return root
    end
    p.PromptButtonHoldBegan:Connect(function(player)
        if validRoot(player) then began[player]={At=os.clock(),Character=player.Character} end
    end)
    p.PromptButtonHoldEnded:Connect(function(player)
        local stamp=began[player]
        -- Touch/gamepad may deliver HoldEnded before the final Triggered event.
        task.delay(.45,function() if began[player]==stamp then began[player]=nil end end)
    end)
    p.Triggered:Connect(function(player)
        local root=validRoot(player); if not root then return end
        local stamp=began[player]
        if hold>0 then
            if not stamp or stamp.Character~=player.Character then return end
            local elapsed=os.clock()-stamp.At
            if elapsed<math.max(0,hold-.15) or elapsed>hold+4 then return end
        end
        local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances={player.Character}
        local ray=workspace:Raycast(root.Position,part.Position-root.Position,params)
        if ray and ray.Instance~=part and not (part.Parent:IsA("Model") and ray.Instance:IsDescendantOf(part.Parent)) then return end
        began[player]=nil; callback(player)
    end)
    return p
end
function World.egg(parent, config, pos, mutation)
    local color=Color3.fromRGB(table.unpack(config.Color)); local size=config.Size
    local model=Instance.new("Model"); model.Name="Egg_"..config.Id; model.Parent=parent
    local p=World.part(model,"Egg",Vector3.new(2.1,2.8,2.1)*size,CFrame.new(pos),color,nil,Enum.PartType.Ball)
    p.CanCollide=false; p.CanTouch=false; p.Massless=true; model.PrimaryPart=p
    local accent=if config.Rarity=="COMMON" then C.Pine else color:Lerp(C.White,.72)
    local function ornament(name,dimensions,offset,shade,shape,rotation)
        local detail=decor(model,name,dimensions*size,p.CFrame*CFrame.new(offset*size)*(rotation or CFrame.identity),shade,nil,shape)
        detail.Massless=true
        local weld=Instance.new("WeldConstraint"); weld.Part0=p; weld.Part1=detail; weld.Parent=detail
        detail.Anchored=false; return detail
    end
    local pattern=string.lower(config.Pattern or "Spots")
    local specialRing=pattern=="rings" or pattern=="stripes" or pattern=="swirl" or config.Id=="honey" or config.Id=="sunseed" or config.Id=="orbit"
    if specialRing then
        for _,y in ipairs({-.52,.37}) do
            local radius=math.sqrt(1-(y/1.4)^2)*1.07
            ornament("ShellBand",Vector3.new(.1,radius*2,radius*2),Vector3.new(0,y,0),accent,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
        end
    end
    for i=1,if specialRing then 4 else 7 do
        local angle=i*2.39996; local y=((i%3)-1)*.48
        local radius=math.sqrt(1-(y/1.4)^2)*1.035
        local offset=Vector3.new(math.cos(angle)*radius,y,math.sin(angle)*radius)
        local orientation=CFrame.lookAt(Vector3.zero,Vector3.new(offset.X,offset.Y*.6,offset.Z))
        ornament("ShellMark",Vector3.new(.29+(i%2)*.12,.38,.12),offset,accent,Enum.PartType.Ball,orientation)
    end
    if config.Id=="clover" or config.Id=="moonbud" or pattern=="leaves" then
        for i=1,3 do
            local a=i*math.pi*2/3
            ornament("LeafCrown",Vector3.new(.36,.13,.65),Vector3.new(math.sin(a)*.21,1.38,math.cos(a)*.21),
                if config.Id=="clover" then C.Leaf else accent,Enum.PartType.Ball,CFrame.Angles(0,a,.18))
        end
    end
    if config.Rarity~="COMMON" and config.Rarity~="UNCOMMON" then
        local light=Instance.new("PointLight"); light.Color=color; light.Range=6; light.Brightness=.4; light.Shadows=false; light.Parent=p
    end
    if config.Rarity=="LEGENDARY" or config.Rarity=="SECRET" or config.Rarity=="MYTHIC" or config.Rarity=="DIVINE" or mutation then
        local emitter=Instance.new("ParticleEmitter"); emitter.Name="RareSparkles"
        emitter.Texture="rbxasset://textures/particles/sparkles_main.dds"
        emitter.Rate=2; emitter.Lifetime=NumberRange.new(.55,.85); emitter.Speed=NumberRange.new(.25,.6)
        emitter.LightEmission=.5; emitter.Color=ColorSequence.new(accent)
        emitter.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.1),NumberSequenceKeypoint.new(1,0)}); emitter.Parent=p
    end
    if mutation then
        local h=Instance.new("Highlight"); h.FillTransparency=.88; h.OutlineTransparency=.35
        h.OutlineColor=C.Gold; h.DepthMode=Enum.HighlightDepthMode.Occluded; h.Parent=model
    end
    return model
end
local function lamp(parent,pos)
    decor(parent,"LanternFoot",Vector3.new(1.5,.5,1.5),CFrame.new(pos+Vector3.new(0,.9,0)),C.Teal)
    decor(parent,"LanternPost",Vector3.new(.38,6,.38),CFrame.new(pos+Vector3.new(0,3.9,0)),C.Teal)
    decor(parent,"LanternGlass",Vector3.new(1.1,1.35,1.1),CFrame.new(pos+Vector3.new(0,7.2,0)),C.Gold,Enum.Material.Neon)
    decor(parent,"LanternCap",Vector3.new(1.7,.32,1.7),CFrame.new(pos+Vector3.new(0,8,0)),C.Teal)
end
local function sign(parent,pos,title,subtitle)
    decor(parent,"SignPost",Vector3.new(.8,5.8,.8),CFrame.new(pos+Vector3.new(0,3,0)),C.Wood)
    local face=decor(parent,"Wayfinding",Vector3.new(10,4,.6),CFrame.new(pos+Vector3.new(0,5.6,0)),C.Teal)
    decor(parent,"SignCap",Vector3.new(10.5,.25,.8),face.CFrame*CFrame.new(0,2.1,0),C.Gold)
    local text=World.label(face,title.."\n"..subtitle,C.White)
    text.Parent.StudsOffset=Vector3.new(0,.1,0); text.Parent.Size=UDim2.fromOffset(225,58)
    return face,text
end
local function tree(parent,pos,scale,index)
    local frame=CFrame.new(pos)*CFrame.Angles(0,index*.79,0)
    World.part(parent,"CloverTrunk",Vector3.new(1.9,7,1.9)*scale,frame*CFrame.new(0,4*scale,0),C.Wood,Enum.Material.Wood)
    for j=1,3 do
        local a=j*math.pi*2/3
        decor(parent,"LeafCloud",Vector3.new(8.2,7,8)*scale,
            frame*CFrame.new(math.sin(a)*2.4*scale,(9+(j%2))*scale,math.cos(a)*2.4*scale),
            if j==2 then C.GrassLight else C.Leaf,nil,Enum.PartType.Ball)
    end
    decor(parent,"CloverCrown",Vector3.new(7,6,7)*scale,frame*CFrame.new(0,13*scale,0),C.Leaf,nil,Enum.PartType.Ball)
end
local function clearMeadow(pos,margin)
    if math.abs(pos.X)<18 then return false end
    for _,nest in ipairs(nestPositions) do
        if (Vector3.new(pos.X,1,pos.Z)-nest).Magnitude<margin then return false end
        if (Vector3.new(pos.X,1,pos.Z)-(nest+Vector3.new(10,0,5))).Magnitude<margin then return false end
    end
    return true
end
-- Packaged places contain this exact geometry for the editor. Reuse it at
-- runtime and remove only explicitly tagged display actors, never user objects.
local function preparedWorld()
    local map=workspace:FindFirstChild("Map")
    if not map or map:GetAttribute("HeistBakedVersion")~=1 then return nil end
    local hub=map:FindFirstChild("Hub")
    local bases=map:FindFirstChild("PlayerBases")
    local eggs=map:FindFirstChild("Eggs")
    local nests=map:FindFirstChild("Nests")
    local biomes=map:FindFirstChild("Biomes")
    local meadow=biomes and biomes:FindFirstChild("GreenMeadow")
    local secret=meadow and meadow:FindFirstChild("SecretShrine")
    local board=hub and hub:FindFirstChild("ServerScores")
    local gui=board and board:FindFirstChild("Label")
    local boardText=gui and gui:FindFirstChildWhichIsA("TextLabel")
    if not hub or not bases or not eggs or not nests or not secret or not boardText then return nil end
    local entries={}
    for i=1,3 do
        local nest=nests:FindFirstChild("Nest"..i)
        if not nest or not nest:IsA("BasePart") then return nil end
        table.insert(entries,{Part=nest,Home=nest.CFrame.Position+Vector3.new(10,3,5),Index=i})
    end
    for _,folder in ipairs({map,bases,eggs}) do
        for _,object in ipairs(folder:GetChildren()) do
            if object:GetAttribute("HeistEditorDisplay")==true then object:Destroy() end
        end
    end
    return {Map=map,Hub=hub,Bases=bases,Eggs=eggs,Nests=entries,Secret=secret,Board=boardText}
end
function World.build()
    local existing=preparedWorld()
    if existing then return existing end
    local previous=workspace:FindFirstChild("Map")
    if previous and previous:GetAttribute("HeistBakedVersion")==1 then previous:Destroy() end
    local map=Instance.new("Folder"); map.Name="Map"; map.Parent=workspace
    local hub=Instance.new("Folder"); hub.Name="Hub"; hub.Parent=map
    local biomes=Instance.new("Folder"); biomes.Name="Biomes"; biomes.Parent=map
    local meadow=Instance.new("Folder"); meadow.Name="GreenMeadow"; meadow.Parent=biomes
    local bases=Instance.new("Folder"); bases.Name="PlayerBases"; bases.Parent=map
    local nests=Instance.new("Folder"); nests.Name="Nests"; nests.Parent=map
    local objects=Instance.new("Folder"); objects.Name="Eggs"; objects.Parent=map
    World.part(hub,"HubIsland",Vector3.new(150,8,230),CFrame.new(0,-4,-40),C.Teal)
    World.part(hub,"IslandFoundation",Vector3.new(142,7,222),CFrame.new(0,-10,-40),C.Ink)
    World.part(hub,"Plaza",Vector3.new(142,1,224),CFrame.new(0,.15,-40),C.Cream,Enum.Material.Sandstone)
    for _,x in ipairs({-73,73}) do
        decor(hub,"GardenBorder",Vector3.new(3,1,226),CFrame.new(x,.6,-40),C.Pine)
        decor(hub,"GoldIslandTrim",Vector3.new(.35,.35,230),CFrame.new(x*1.022,-2,-40),C.Gold)
    end
    World.part(meadow,"MeadowIsland",Vector3.new(190,9,185),CFrame.new(0,-4,166),C.Grass,Enum.Material.Grass)
    World.part(meadow,"EarthRim",Vector3.new(196,6,190),CFrame.new(0,-9,166),C.Earth,Enum.Material.Slate)
    World.part(meadow,"DeepEarth",Vector3.new(180,6,177),CFrame.new(0,-14,166),C.Ink,Enum.Material.Slate)
    for _,x in ipairs({-91,91}) do
        decor(meadow,"MeadowLip",Vector3.new(5,1,180),CFrame.new(x,.2,166),C.GrassLight,Enum.Material.Grass)
    end
    decor(hub,"MainAvenue",Vector3.new(20,.12,143),CFrame.new(0,.72,-8),Color3.fromRGB(220,209,177))
    for _,z in ipairs({-110,-83,-56,-29}) do
        decor(hub,"BaseAvenue",Vector3.new(104,.12,5),CFrame.new(0,.76,z+6),Color3.fromRGB(226,215,186))
    end
    World.part(hub,"Bridge",Vector3.new(24,1,30),CFrame.new(0,.3,82),C.Wood,Enum.Material.WoodPlanks)
    for _,x in ipairs({-13,13}) do
        for _,z in ipairs({69,82,95}) do
            World.part(hub,"BridgePost",Vector3.new(.9,4,.9),CFrame.new(x,2.3,z),C.Teal)
            decor(hub,"BridgeFinial",Vector3.new(1.3,.7,1.3),CFrame.new(x,4.6,z),C.Gold,nil,Enum.PartType.Ball)
        end
        decor(hub,"BridgeRail",Vector3.new(.5,.65,28),CFrame.new(x,3,82),C.Cream)
    end
    for z=4,124,8 do
        decor(if z<97 then hub else meadow,"GoldenTrail",Vector3.new(4,.12,4.6),CFrame.new(0,.9,z),C.Gold)
    end
    local spawn=Instance.new("SpawnLocation"); spawn.Name="SpawnArea"; spawn.Size=Vector3.new(11,.4,11)
    spawn.CFrame=CFrame.new(0,1,0); spawn.Anchored=true; spawn.Neutral=true; spawn.Duration=3; spawn.Transparency=1; spawn.Parent=hub
    disc(hub,"ArrivalSeal",Vector3.new(0,.83,0),7,.16,C.Teal)
    ring(hub,"ArrivalInlay",Vector3.new(0,.97,0),7.2,.25,C.Gold,16)
    -- The fountain and oversized egg anchor the hub, behind the spawn.
    disc(hub,"FountainFoundation",Vector3.new(0,1,-30),12,.7,C.Teal,nil,true)
    disc(hub,"FountainBasin",Vector3.new(0,1.55,-30),10.9,.45,C.Cream)
    disc(hub,"StillWater",Vector3.new(0,1.84,-30),10.1,.12,C.Water,Enum.Material.Glass)
    ring(hub,"FountainRim",Vector3.new(0,2,-30),10.8,.65,C.Cream,20)
    disc(hub,"FountainPedestal",Vector3.new(0,3.1,-30),3,2.7,C.Teal)
    disc(hub,"PedestalGilt",Vector3.new(0,4.6,-30),3.4,.3,C.Gold)
    decor(hub,"HeistEggMonument",Vector3.new(5.7,7.7,5.7),CFrame.new(0,8.3,-30),C.Gold,Enum.Material.Metal,Enum.PartType.Ball)
    ring(hub,"MonumentHalo",Vector3.new(0,8,-30),4,.16,C.Cream,12)
    local emblem=decor(hub,"FountainPlaque",Vector3.new(7,.7,2),CFrame.new(0,2.1,-18),C.Teal)
    World.label(emblem,"STEAL AN EGG\nКлуб великих побегов",C.Gold)
    local gate=decor(hub,"MeadowGate",Vector3.new(25,2.4,3.4),CFrame.new(0,16,60),C.Teal)
    decor(hub,"GateCornice",Vector3.new(27,.5,4.2),CFrame.new(0,17.5,60),C.Gold)
    for _,x in ipairs({-12,12}) do
        World.part(hub,"GatePillar",Vector3.new(2.6,15,3.3),CFrame.new(x,7.5,60),C.Teal)
        decor(hub,"GateBase",Vector3.new(4.2,1.5,4.5),CFrame.new(x,.9,60),C.Cream)
        decor(hub,"GateMedallion",Vector3.new(1.4,1.8,.25),CFrame.new(x,12,58.2),C.Gold,nil,Enum.PartType.Ball)
    end
    local gateText=World.label(gate,"КЛЕВЕРНЫЕ ЛУГА\nУкради → убеги → вылупи",C.White)
    gateText.Parent.StudsOffset=Vector3.new(0,1.7,0)
    sign(hub,Vector3.new(18,.3,45),"ВПЕРЁД · ЛУГА","По золотой дорожке")
    sign(hub,Vector3.new(-18,.3,10),"УБЕЖИЩА · НАЗАД","Доставь яйцо на свою платформу")
    World.part(hub,"OutfitterDeck",Vector3.new(23,1,18),CFrame.new(-42,1,14),C.Wood,Enum.Material.WoodPlanks)
    World.part(hub,"Outfitter",Vector3.new(19,8,2),CFrame.new(-42,5.5,21),C.Teal)
    decor(hub,"ShopCounter",Vector3.new(17,3,3),CFrame.new(-42,3,8),C.Teal)
    decor(hub,"CounterTop",Vector3.new(18,.45,4),CFrame.new(-42,4.7,8),C.Cream)
    for i=1,6 do
        decor(hub,"ShopAwning",Vector3.new(3.5,.6,15),CFrame.new(-52.5+i*3,10,14)*CFrame.Angles(-.08,0,0),if i%2==0 then C.Gold else C.Cream)
    end
    for _,x in ipairs({-52,-32}) do decor(hub,"ShopPost",Vector3.new(.65,9,.65),CFrame.new(x,5.5,7),C.Teal) end
    sign(hub,Vector3.new(-42,6,22),"СНАРЯЖЕНИЕ","Улучшения в меню")
    for i=1,3 do
        disc(hub,"EquipmentStand",Vector3.new(-48+i*3,5.15,8),.8,.4,C.Gold)
        decor(hub,"EquipmentCrate",Vector3.new(1.3,1.2,1.4),CFrame.new(-48+i*3,5.9,8)*CFrame.Angles(0,i*.4,0),C.Mint)
    end
    local board=sign(hub,Vector3.new(38,.8,17),"ЕЖЕДНЕВНЫЕ ЦЕЛИ","3 доставки · 1 питомец"); board.Name="QuestBoard"
    local leaderboard,boardText=sign(hub,Vector3.new(38,.8,-1),"ЛУЧШИЕ ПОБЕГИ","Таблица игроков: Tab"); leaderboard.Name="ServerScores"
    disc(hub,"EventStage",Vector3.new(-42,1.1,41),8,1.1,C.Teal,nil,true)
    ring(hub,"EventTrim",Vector3.new(-42,1.75,41),7,.3,C.Gold,12)
    local event=decor(hub,"EventPlinth",Vector3.new(4,3,4),CFrame.new(-42,3,41),C.Gold)
    World.label(event,"ЗОЛОТАЯ ЛИХОРАДКА\nКаждые 5 минут",C.Gold)
    for _,pos in ipairs({Vector3.new(-23,0,-7),Vector3.new(23,0,-7),Vector3.new(-22,0,41),Vector3.new(24,0,27),
        Vector3.new(-23,0,-62),Vector3.new(23,0,-62),Vector3.new(-23,0,-117),Vector3.new(23,0,-117)}) do lamp(hub,pos) end
    local rng=Random.new(1907)
    for i=1,24 do
        local x=if i%2==0 then rng:NextNumber(28,85) else rng:NextNumber(-85,-28)
        local pos=Vector3.new(x,.5,rng:NextNumber(108,248))
        if clearMeadow(pos,22) then tree(meadow,pos,rng:NextNumber(.8,1.25),i) end
    end
    for i=1,28 do
        local pos=Vector3.new(rng:NextNumber(-86,86),.8,rng:NextNumber(104,250))
        if clearMeadow(pos,14) then
            decor(meadow,"FlowerLeaf",Vector3.new(1.3,.3,.7),CFrame.new(pos),C.Pine,nil,Enum.PartType.Ball)
            local shade=if i%3==0 then Color3.fromRGB(231,161,177) elseif i%3==1 then C.Gold else C.White
            for j=1,3 do
                local a=j*math.pi*2/3
                decor(meadow,"CloverPetal",Vector3.new(.55,.3,.55),CFrame.new(pos+Vector3.new(math.sin(a)*.28,.33,math.cos(a)*.28)),shade,nil,Enum.PartType.Ball)
            end
        end
    end
    for i=1,12 do
        local x=if i%2==0 then -87 else 87
        decor(meadow,"LayeredCliff",Vector3.new(12,8+(i%3)*3,12),CFrame.new(x,-1,98+i*12)*CFrame.Angles(.1,i*.73,.15),
            if i%2==0 then C.Stone else C.Earth,Enum.Material.Slate)
    end
    for _,v in ipairs({Vector3.new(-27,3,160),Vector3.new(32,3,182),Vector3.new(-27,2,229),Vector3.new(48,3,132)}) do
        World.part(meadow,"CoverRock",Vector3.new(11,6,8),CFrame.new(v)*CFrame.Angles(.12,v.Z,.12),C.Stone,Enum.Material.Slate,Enum.PartType.Ball)
        decor(meadow,"RockMoss",Vector3.new(8,1,5),CFrame.new(v+Vector3.new(0,2.5,0)),C.GrassLight,nil,Enum.PartType.Ball)
    end
    World.part(meadow,"FallenLog",Vector3.new(6,6,22),CFrame.new(-54,3.2,174)*CFrame.Angles(0,.3,0),C.Wood,Enum.Material.Wood)
    for z=130,215,14 do disc(meadow,"SecretSteps",Vector3.new(-71,.7,z),2.8,.25,C.Cream,nil,true) end
    disc(meadow,"ShrineFloor",Vector3.new(-73,.7,220),6,.4,C.Stone,nil,true)
    local secret=World.part(meadow,"SecretShrine",Vector3.new(3.4,2,3.4),CFrame.new(-73,1.7,220),C.Mint)
    for _,x in ipairs({-79,-67}) do decor(meadow,"ShrinePillar",Vector3.new(1.5,8,1.8),CFrame.new(x,4.7,224),C.Teal) end
    decor(meadow,"ShrineLintel",Vector3.new(15,2,3),CFrame.new(-73,9.6,224),C.Teal)
    decor(meadow,"ShrineJewel",Vector3.new(2,2.5,1),CFrame.new(-73,10.8,223),C.Gold,nil,Enum.PartType.Ball)
    World.label(secret,"ТРОПА ТИХИХ ШАГОВ\nИсследуй древний клевер",C.Mint)
    sign(meadow,Vector3.new(-23,.5,111),"ТИХАЯ ТРОПА · ВЛЕВО","Исследуй край острова")
    local nestsList={}
    for i,pos in ipairs(nestPositions) do
        disc(nests,"NestClearing",pos+Vector3.new(0,-.38,0),8.6,.2,Color3.fromRGB(177,188,117))
        local nest=disc(nests,"Nest"..i,pos,4.2,.7,C.Wood,nil,true)
        disc(nests,"NestStraw",pos+Vector3.new(0,.45,0),3.65,.25,C.Gold)
        for j=1,12 do
            local a=j*math.pi/6
            decor(nests,"WovenTwig",Vector3.new(3.2,.6,.6),CFrame.new(pos+Vector3.new(math.sin(a)*3.6,.7,math.cos(a)*3.6))*CFrame.Angles(.1,a,.12),
                if j%2==0 then C.Wood else Color3.fromRGB(202,159,96),Enum.Material.Wood)
        end
        for j=1,3 do decor(nests,"LooseStraw",Vector3.new(2,.12,.24),CFrame.new(pos+Vector3.new(j-2,.63,(j%2)*1.3-.6))*CFrame.Angles(0,j,0),C.Cream) end
        table.insert(nestsList,{Part=nest,Home=pos+Vector3.new(10,3,5),Index=i})
    end
    for _,name in ipairs({"HeistAtmosphere","HeistGrade","HeistBloom","HeistSunRays"}) do
        local old=Lighting:FindFirstChild(name); if old then old:Destroy() end
    end
    local atmosphere=Instance.new("Atmosphere"); atmosphere.Name="HeistAtmosphere"
    atmosphere.Density=.19; atmosphere.Offset=.1; atmosphere.Color=Color3.fromRGB(219,237,235)
    atmosphere.Decay=Color3.fromRGB(150,177,182); atmosphere.Glare=.08; atmosphere.Haze=.7; atmosphere.Parent=Lighting
    local cc=Instance.new("ColorCorrectionEffect"); cc.Name="HeistGrade"
    cc.Saturation=.08; cc.Contrast=.035; cc.Brightness=.015; cc.TintColor=Color3.fromRGB(255,250,240); cc.Parent=Lighting
    local bloom=Instance.new("BloomEffect"); bloom.Name="HeistBloom"; bloom.Intensity=.14; bloom.Size=20; bloom.Threshold=1.45; bloom.Parent=Lighting
    local rays=Instance.new("SunRaysEffect"); rays.Name="HeistSunRays"; rays.Intensity=.025; rays.Spread=.6; rays.Parent=Lighting
    Lighting.ClockTime=14.2; Lighting.Brightness=2.2; Lighting.GlobalShadows=true
    Lighting.Ambient=Color3.fromRGB(115,133,143); Lighting.OutdoorAmbient=Color3.fromRGB(148,162,153)
    Lighting.EnvironmentDiffuseScale=.7; Lighting.EnvironmentSpecularScale=.45
    return {Map=map,Hub=hub,Bases=bases,Eggs=objects,Nests=nestsList,Secret=secret,Board=boardText}
end
function World.base(world, index, player)
    local x=if index%2==0 then 51 else -51; local z=-29-math.floor((index-1)/2)*27
    local model=Instance.new("Model"); model.Name="Base_"..player.UserId; model.Parent=world.Bases
    local tint=if index%2==0 then C.Teal else Color3.fromRGB(78,118,111)
    World.part(model,"Foundation",Vector3.new(31,.8,25),CFrame.new(x,.6,z),C.Teal)
    World.part(model,"Deck",Vector3.new(29,1,24),CFrame.new(x,1,z),C.Cream,Enum.Material.Sandstone)
    World.part(model,"BackWall",Vector3.new(29,8.5,1),CFrame.new(x,5.6,z-12),tint)
    decor(model,"BackWallTrim",Vector3.new(29,.35,.3),CFrame.new(x,8.3,z-11.4),C.Gold)
    decor(model,"Canopy",Vector3.new(31,1,12),CFrame.new(x,10.3,z-6)*CFrame.Angles(-.055,0,0),tint)
    decor(model,"CanopyFascia",Vector3.new(31,.65,.5),CFrame.new(x,9.9,z),C.Gold)
    for _,offset in ipairs({-13.5,13.5}) do
        decor(model,"CanopyPost",Vector3.new(.7,8,.7),CFrame.new(x+offset,5.5,z-.4),tint)
        decor(model,"CornerCap",Vector3.new(1.2,.5,1.2),CFrame.new(x+offset,1.8,z+10.5),C.Gold)
    end
    local pad=World.part(model,"DeliveryPad",Vector3.new(12,.25,9),CFrame.new(x,1.7,z+5),C.Mint)
    decor(model,"DeliveryMark",Vector3.new(8,.04,.3),pad.CFrame*CFrame.new(0,.15,3.3),C.Teal)
    for _,side in ipairs({-1,1}) do decor(model,"DeliveryEdge",Vector3.new(.25,.08,8),pad.CFrame*CFrame.new(side*5.6,.17,0),C.Teal) end
    local name=decor(model,"OwnerPlaque",Vector3.new(10,1,.5),CFrame.new(x,7.4,z-11.3),C.Teal)
    local ownerText=World.label(name,player.DisplayName.."\nУБЕЖИЩЕ "..string.format("%02d",index),C.White)
    ownerText.Parent.StudsOffset=Vector3.new(0,.2,0); ownerText.Parent.MaxDistance=65
    local padText=World.label(pad,"ДОСТАВКА ЯЙЦА",C.Mint); padText.Parent.StudsOffset=Vector3.new(0,1.2,0); padText.Parent.MaxDistance=28
    disc(model,"IncubatorFoot",Vector3.new(x-8,1.8,z-5),3,.5,tint)
    local incubator=World.part(model,"Incubator",Vector3.new(4.7,1.5,4.7),CFrame.new(x-8,2.6,z-5),C.Gold)
    disc(model,"IncubatorNest",Vector3.new(x-8,3.45,z-5),2.15,.25,C.Cream)
    for _,offset in ipairs({-2.4,2.4}) do decor(model,"IncubatorHoop",Vector3.new(.3,3.2,.3),CFrame.new(x-8+offset,4.15,z-5),C.Teal) end
    decor(model,"IncubatorLamp",Vector3.new(5.5,.35,1),CFrame.new(x-8,5.8,z-5),C.Mint,Enum.Material.Neon)
    local incubatorText=World.label(incubator,"ИНКУБАТОР",C.Gold); incubatorText.Parent.MaxDistance=35
    local ward=World.part(model,"Ward",Vector3.new(1.5,2.5,1.5),CFrame.new(x+11,3,z+2),C.Mint)
    disc(model,"WardFoot",Vector3.new(x+11,1.8,z+2),1.3,.4,tint)
    decor(model,"WardBell",Vector3.new(2,1.6,2),CFrame.new(x+11,4.4,z+2),C.Gold,Enum.Material.Metal,Enum.PartType.Ball)
    local wardText=World.label(ward,"ЩИТ",C.Mint); wardText.Parent.MaxDistance=26
    local display=World.part(model,"PetPedestal",Vector3.new(6,1,6),CFrame.new(x+7,2,z-5),tint)
    disc(model,"PetDisplayTrim",Vector3.new(x+7,2.55,z-5),2.8,.16,C.Gold)
    return {Model=model,Pad=pad,Incubator=incubator,Ward=ward,Display=display,Center=Vector3.new(x,2,z),Index=index}
end
return World
]]></string>
