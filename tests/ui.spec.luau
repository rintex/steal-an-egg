local Layout = require("../src/client/Controllers/UILayout")
local passed = 0
local function test(name, callback)
    local ok, failure = pcall(callback)
    if not ok then error("FAIL " .. name .. ": " .. tostring(failure)) end
    passed += 1
    print("PASS " .. name)
end

test("safe area layouts retain usable cards on portrait, landscape and desktop", function()
    for _, viewport in ipairs({{320, 568}, {360, 740}, {390, 844}, {568, 320}, {844, 390}, {1024, 768}, {1920, 1080}, {2560, 1440}}) do
        local m = Layout.measure(viewport[1], viewport[2])
        assert(m.PanelWidth <= viewport[1] - m.Margin * 2)
        assert(m.PanelHeight <= viewport[2] - m.Margin * 2)
        assert(m.CardWidth >= 200, tostring(viewport[1]) .. " has unreadable cards")
        assert(m.BodyWidth >= m.CardWidth and m.BodyHeight > 120)
        assert(m.CardHeight >= 166)
        assert(m.TopWidth <= viewport[1] - m.Margin * 2)
        assert(m.Columns * m.CardWidth + (m.Columns - 1) * 12 <= m.BodyWidth - 10)
    end
end)
test("mobile layouts reflow instead of shrinking the entire canvas", function()
    local mobile = Layout.measure(390, 844)
    local desktop = Layout.measure(1920, 1080)
    assert(mobile.Portrait and mobile.Columns == 1 and not mobile.SideNav)
    assert(not desktop.Portrait and desktop.SideNav and desktop.Columns >= 2)
    local landscape = Layout.measure(844, 390)
    assert(landscape.Short and landscape.SideNav and not landscape.Portrait)
end)
test("coin groups and countdown boundaries are readable", function()
    assert(Layout.number(0) == "0")
    assert(Layout.number(1234) == "1 234")
    assert(Layout.number(10000000) == "10 000 000")
    assert(Layout.clock(-1) == "0:00")
    assert(Layout.clock(60) == "1:00")
    assert(Layout.clock(1.1) == "0:02")
end)
test("collection search accepts Russian case and literal pattern characters", function()
    assert(Layout.matches("Клеверное COMMON", "КЛЕВЕР"))
    assert(Layout.matches("ЛУННЫЙ БУТОН", "лунный"))
    assert(Layout.matches("Ёжик", "ёжик"))
    assert(Layout.matches("Семя солнца LEGENDARY", "legendary"))
    assert(Layout.matches("Pet [rare]", "[rare]"))
    assert(not Layout.matches("Клеверное COMMON", "EPIC"))
    assert(Layout.matches("anything", ""))
end)
test("purchase states cannot offer maxed, unaffordable or pending upgrades", function()
    local allowed, _, reason = Layout.upgrade(4, 4, 1000, 100, false)
    assert(not allowed and reason == "max")
    allowed, _, reason = Layout.upgrade(0, 4, 59, 60, false)
    assert(not allowed and reason == "funds")
    allowed, _, reason = Layout.upgrade(0, 4, 60, 60, true)
    assert(not allowed and reason == "pending")
    allowed, _, reason = Layout.upgrade(0, 4, 60, 60, false)
    assert(allowed and reason == "ready")
end)
test("incubation action requires range and never resubmits an incubating egg", function()
    local allowed, label = Layout.eggAction(0, 100, false, false)
    assert(not allowed and label == "К инкубатору")
    assert(Layout.eggAction(0, 100, true, false))
    assert(not Layout.eggAction(0, 100, true, true))
    allowed, label = Layout.eggAction(125, 100, true, false)
    assert(not allowed and label == "0:25")
    allowed, label = Layout.eggAction(100, 100, true, false)
    assert(not allowed and label == "Вылупляется…")
end)
test("daily reward enables only after both authoritative goals are complete", function()
    assert(not Layout.daily(3, 0, false, 3, 1))
    assert(not Layout.daily(2, 1, false, 3, 1))
    assert(Layout.daily(3, 1, false, 3, 1))
    assert(Layout.daily(30, 10, false, 3, 1))
    assert(not Layout.daily(3, 1, true, 3, 1))
end)
test("viewport eligibility excludes fully clipped cards at exact scroll boundaries", function()
    assert(not Layout.visible(0, 166, 166, 300))
    assert(Layout.visible(0, 166, 165, 300))
    assert(Layout.visible(400, 166, 166, 300))
    assert(not Layout.visible(466, 166, 166, 300))
end)
print(string.format("PASS %d UI presentation tests (Roblox rendering is not exercised)", passed))
